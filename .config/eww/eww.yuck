;; TODO:
;; - Add visualizer feature under the album art

;; user name getter
(defpoll user :interval "5m"
    `getent passwd "$USER" | cut -d ':' -f 5 | cut -d ',' -f 1 | awk '{print $1}'`
)

;; time keeper
(defpoll time :interval "5s"
  `date +'{
    "hour":"%H",
    "min":"%M",
    "month":"%b",
    "date":"%d",
    "year":"%Y"
   }'`
)

;; sysmon watchers
(defpoll cpubar :interval "1s" `scripts/sysmon-bar --cpu`)
(defpoll rambar :interval "1s" `scripts/sysmon-bar --ram`)
(defpoll diskbar :interval "1s" `scripts/sysmon-bar --disk`)
(defpoll fan :interval "1s" `sensors | grep -E '^fan[0-9]' | awk '{print $2}' | paste -sd+ | bc`)
(defpoll temp :interval "1s" `sensors | grep Tctl | awk '{printf "%.0f", $2}'`)

;; mpris media player
(defpoll mpris-title :interval "1s" `scripts/mpris-watcher --title`)
(defpoll mpris-artist :interval "1s" `scripts/mpris-watcher --artist`)
(defpoll mpris-art :interval "1s" `scripts/mpris-watcher --get-art`)

(defwidget left_group []
    (box :orientation "vertical" :class "white-main" :valign "center" :spacing -80

        ;; clock and date
        (box :orientation "vertical" :spacing -70 :valign "center"
            (label :class "clock" :halign "start" :text "${time.hour}:${time.min}")
            (label :class "date" :xalign 0 :text "${time.month} ${time.date}, ${time.year}"))

        ;; system monitor
        (box :orientation "vertical" :valign "start"
            (label :class "sysmon" :halign "start" :text "System Monitor" :style "margin-bottom: 15px")

            ;; cpu
            (box :orientation "horizontal" :class "sysmon-item" :halign "start"
                (label :class "sysmon" :halign "start" :text "")
                (label :class "sysmon-bar" :halign "start" :text "${cpubar}"))

            ;; ram
            (box :orientation "horizontal" :class "sysmon-item" :halign "start"
                (label :class "sysmon" :halign "start" :text "")
                (label :class "sysmon-bar" :halign "start" :text "${rambar}"))

            ;; disk
            (box :orientation "horizontal" :class "sysmon-item" :halign "start"
                (label :class "sysmon" :halign "start" :text "")
                (label :class "sysmon-bar" :halign "start" :text "${diskbar}"))

            (label :class "sysmon-item sysmon-label" :halign "start" :text " ") ;; gap
            (label :class "sysmon-item sysmon-label" :halign "start" :text "   ${fan} RPM") ;; fan
            (label :class "sysmon-item sysmon-label" :halign "start" :text "   ${temp}°C") ;; temp
            (label :class "sysmon-item sysmon-label" :halign "start" :text "   ${round(EWW_NET.eno1.NET_UP / 1000, 1) } kB/s") ;; net up
            (label :class "sysmon-item sysmon-label" :halign "start" :text "   ${round(EWW_NET.eno1.NET_DOWN / 1000, 1) } kB/s") ;; net down
        )
    )
)

(defwidget right_group []
    (box :orientation "vertical" :class "white-main" :valign "center" :spacing 1

        ;; greeter
        (box :orientation "vertical" :halign "end" :spacing -20
            (label :class "greeter"
                :text {
                    time.hour >= 3 && time.hour < 12 ? "Bom dia," :
                    time.hour >= 12 && time.hour < 18 ? "Boa tarde," : "Boa noite,"
                }
            )
            (label :class "user" :halign "end" :wrap true :text "${user}")
        )

        ;; media player
        (box :orientation "horizontal" :halign "end" :space-evenly "false"
             :vexpand "false" :hexpand "false"

            (box :orientation "vertical" :spacing -140
                (label :class "media-title" :halign "end" :text "${mpris-title ?: 'N/A'}")
                (label :class "media-artist" :halign "end" :text "${mpris-artist ?: (mpris-title != '' ? 'Advertisement' : 'No Media Playing')}")
            )
            (box :class "media-art"
                 :style "background-image: url('${mpris-art}'), url('images/art-default.png');")
        )
    )
)

;; windows ---------------------------------------------------------------------

(defwindow left_window
    :stacking "bottom" :windowtype "desktop" :wm-ignore false
    :monitor "PHL 278E1"
    :geometry (geometry :x "7%" :y "4%" :width "30%" :height "80%" )
    (left_group))

(defwindow right_window
    :stacking "bottom" :windowtype "desktop" :wm-ignore false
    :monitor "PHL 278E1"
    :geometry (geometry :x "63%" :y "4%" :width "30%" :height "80%" )
    (right_group))
